// NexCare API — Prisma schema.
//
// Defines the database connection, the client generator, and the domain models.
// Every model follows the conventions in CLAUDE.md §4.2 — TIMESTAMPTZ dates,
// E.164 phone strings, soft-delete via `deletedAt` where applicable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Biological sex recorded at registration. A small closed set kept in the
/// database as a native enum so the value is constrained at the storage layer,
/// not just in application validation.
enum Sex {
  MALE
  FEMALE
  OTHER
}

/// A patient of Elara Healthcare. This is PII/PHI under the Kenya Data
/// Protection Act, 2019 — access is logged (Issue #8) and the row is never hard
/// deleted: `deletedAt` marks a soft delete so clinical history is retained.
model Patient {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  // Clinical dates always carry a timezone (CLAUDE.md §4.2).
  dateOfBirth DateTime  @db.Timestamptz(3)
  sex         Sex
  // E.164 string, e.g. +254712345678.
  phone       String?
  // National ID is a natural unique key when present; optional at registration.
  nationalId  String?   @unique
  email       String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  // Soft-delete marker. NULL = active; a timestamp = deleted (row retained).
  deletedAt   DateTime? @db.Timestamptz(3)

  // Back-relation to bookings. A patient may have many appointments over time.
  appointments Appointment[]

  @@map("patients")
}

/// Lifecycle of a booked appointment. Kept as a native Postgres enum so the
/// value is constrained at the storage layer, not just in application validation.
enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A booked appointment for a patient. Soft-deleted via `deletedAt` so the
/// clinical record is retained (CLAUDE.md §4.2). The patient relation uses
/// `onDelete: Restrict` to preserve referential integrity: a patient with
/// appointments cannot be hard-deleted out from under them.
model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  patient         Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  // Clinical dates always carry a timezone (CLAUDE.md §4.2).
  scheduledFor    DateTime          @db.Timestamptz(3)
  durationMinutes Int               @default(30)
  reason          String?
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  // Soft-delete marker. NULL = active; a timestamp = deleted (row retained).
  deletedAt       DateTime?         @db.Timestamptz(3)

  @@index([patientId])
  @@map("appointments")
}

/// The action a mutating request performed, derived from the HTTP method
/// (POST -> CREATE, PUT/PATCH -> UPDATE, DELETE -> DELETE). Kept as a native
/// Postgres enum so the value is constrained at the storage layer.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

/// Append-only audit trail of every mutating request, written by the global
/// audit middleware (src/middleware/audit.ts) for Kenya Data Protection Act,
/// 2019 accountability. Rows are NEVER updated or deleted (CLAUDE.md §4.2).
///
/// Compliance: this table stores NO request/response bodies and NO PII — only
/// the metadata needed to answer "who changed what, when". `actorId` is null
/// until authentication (#10) and RBAC (#12) land and can resolve the caller.
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  // The resource type, e.g. "patient" or "appointment" (no PII).
  entity     String
  // The affected row's id, when known (create result or path :id). Not PII.
  entityId   String?
  // The authenticated caller. Null until auth (#10/#12) lands.
  actorId    String?
  method     String
  // Request pathname only — never the query string, to keep PII out.
  path       String
  statusCode Int
  ipAddress  String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
