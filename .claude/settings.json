{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(COMPLIANCE.md)",
      "Write(COMPLIANCE.md)",
      "Edit(PRIVACY.md)",
      "Write(PRIVACY.md)",
      "Edit(SECURITY.md)",
      "Write(SECURITY.md)",
      "Edit(LICENSE)",
      "Write(LICENSE)",
      "Edit(.env)",
      "Write(.env)",
      "Edit(.env.*)",
      "Write(.env.*)",
      "Edit(prisma/migrations/**)",
      "Write(prisma/migrations/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin master*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fd*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(pnpm prisma migrate reset*)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(pnpm prisma db push --force-reset*)",
      "Bash(prisma db push --force-reset*)",
      "Bash(npx prisma db push --accept-data-loss*)",
      "Bash(docker volume rm *)",
      "Bash(docker compose down -v*)",
      "Bash(docker-compose down -v*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git stash*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(pnpm install*)",
      "Bash(pnpm i)",
      "Bash(pnpm add *)",
      "Bash(pnpm test*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run typecheck*)",
      "Bash(pnpm run format*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm run dev*)",
      "Bash(pnpm exec *)",
      "Bash(pnpm dlx *)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma validate*)",
      "Bash(pnpm prisma generate*)",
      "Bash(pnpm prisma migrate dev*)",
      "Bash(pnpm prisma migrate status*)",
      "Bash(docker ps*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose down)",
      "Bash(docker-compose up*)",
      "Bash(docker-compose ps*)",
      "Bash(docker-compose logs*)",
      "Bash(docker-compose down)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh repo view*)",
      "Bash(gh run watch*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)"
    ],
    "defaultMode": "default"
  }
}
