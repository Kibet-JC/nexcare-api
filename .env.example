# NexCare API — example environment configuration.
# Copy to .env for local dev:  cp .env.example .env
# Real host values (Railway) always win over a local .env. Never commit a populated .env.
# Validated at boot by src/config/env.ts (Zod) — bad values fail the process immediately.

# Runtime mode: development | test | production
NODE_ENV=development

# HTTP port the API binds to
PORT=3000

# pino log verbosity: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://nexcare:nexcare@localhost:5432/nexcare_dev?schema=public

# PostgreSQL connection string (matches docker-compose.yml)
DATABASE_URL=postgresql://nexcare:nexcare@localhost:5432/nexcare_dev?schema=public

# Secret for signing short-lived JWT access tokens.
# Generate a real one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret

# Secret for signing short-lived JWT access tokens.
# Generate a real one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret

